# ============================================================
# Atlas - AI-Powered DevOps Command Center
# Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Bonito Platform ──────────────────────────────────────────
BONITO_API_KEY=your-bonito-api-key
BONITO_API_URL=http://localhost:8001   # For local development
BONITO_ORG_ID=your-org-id
BONITO_PROJECT_ID=your-project-id      # Optional: specify project for agent deployment
BONITO_ENVIRONMENT=development         # production | staging | development
BONITO_GATEWAY_URL=https://gateway.getbonito.com

# ── AI Providers (routed through Bonito Gateway) ────────────
# You only need to configure providers you want to use.
# Bonito Gateway handles routing, fallback, and load balancing.

OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GROQ_API_KEY=gsk_your-groq-key

# AWS Bedrock (optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Azure OpenAI (optional)
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# GCP Vertex AI (optional)
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=us-central1
GCP_SERVICE_ACCOUNT_KEY_PATH=./credentials/gcp-sa.json

# ── Integrations ─────────────────────────────────────────────

# GitHub
GITHUB_TOKEN=ghp_your-github-token
GITHUB_ORG=your-org
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# PagerDuty
PAGERDUTY_API_KEY=your-pagerduty-api-key
PAGERDUTY_WEBHOOK_SECRET=your-pagerduty-webhook-secret
PAGERDUTY_SERVICE_ID=your-service-id

# OpsGenie
OPSGENIE_API_KEY=your-opsgenie-api-key

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_CHANNEL_INCIDENTS=#incidents
SLACK_CHANNEL_DEPLOYS=#deploys
SLACK_CHANNEL_GENERAL=#engineering

# Jira
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=automation@your-org.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=OPS

# Linear
LINEAR_API_KEY=lin_api_your-linear-key
LINEAR_TEAM_ID=your-team-id

# CircleCI (optional, if using alongside GitHub Actions)
CIRCLECI_TOKEN=your-circleci-token

# ── MCP Server URLs (for Atlas bonito.yaml) ──────────────────
# Configure external MCP servers - defaults point to local docker-compose setup
MCP_GITHUB_URL=http://localhost:3100/sse
MCP_PAGERDUTY_URL=http://localhost:3101/sse
MCP_SLACK_URL=http://localhost:3102/sse
MCP_JIRA_URL=http://localhost:3103/sse

# ── Atlas Configuration ──────────────────────────────────────
ATLAS_LOG_LEVEL=info                   # debug | info | warn | error
ATLAS_WEBHOOK_PORT=3000
ATLAS_WEBHOOK_BASE_URL=https://your-domain.com/webhooks
