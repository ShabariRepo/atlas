{
  "mcpServers": {
    "github": {
      "transport": "sse",
      "url": "https://mcp.getbonito.com/github",
      "auth": {
        "type": "bearer",
        "token": "${GITHUB_TOKEN}"
      },
      "capabilities": {
        "pull_requests": {
          "read_diff": true,
          "read_files": true,
          "post_review": true,
          "post_inline_comments": true,
          "request_changes": true,
          "approve": true
        },
        "repositories": {
          "read_contents": true,
          "read_tree": true
        },
        "issues": {
          "read": true,
          "comment": true
        },
        "actions": {
          "read_workflow_runs": true,
          "read_check_suites": true
        }
      },
      "rate_limiting": {
        "requests_per_minute": 30,
        "respect_github_limits": true
      },
      "context": {
        "org": "${GITHUB_ORG}",
        "default_branch": "main"
      }
    }
  }
}
